<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container">
        <InfoBlock @type="info" @icon="lightbulb" @iconSize="lg" class="mb-5">
            <div class="font-extrabold">{{t "ember-ui.components.modals.verify-email.verify-your-email-address"}}</div>
            <div>{{t "ember-ui.components.modals.verify-email.re-verify-your-email-address-and"}}</div>
        </InfoBlock>
        {{#if @options.sent}}
            <InputGroup
                @type="tel"
                @name={{t "ember-ui.components.modals.verify-email.enter-verification-code"}}
                @value={{@options.code}}
                @helpText={{t "ember-ui.components.modals.verify-email.enter-the-code-you-received-in"}}
                @inputClass="input-lg"
            />
        {{else}}
            <InputGroup
                @type="email"
                @name={{t "ember-ui.components.modals.verify-email.verify-your-email-address-2"}}
                @value={{@options.email}}
                @helpText={{t "ember-ui.components.modals.verify-email.have-a-second-look-and-confirm"}}
                @inputClass="input-lg"
            />
        {{/if}}
    </div>
</Modal::Default>