<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container">
        <InputGroup
            @name={{t "ember-ui.components.modals.tip-tap-editor-insert-youtube.youtube-video-url"}}
            @value={{@options.url}}
            @helpText={{t "ember-ui.components.modals.tip-tap-editor-insert-youtube.the-url-to-the-youtube-video"}}
            @inputClass="input-lg"
        />
        <div class="mt-2 grid grid-cols-2 gap-2">
            <InputGroup
                @name={{t "ember-ui.components.modals.tip-tap-editor-insert-youtube.height"}}
                @value={{@options.height}}
                @helpText={{t "ember-ui.components.modals.tip-tap-editor-insert-youtube.the-height-of-the-youtube-video"}}
                @inputClass="input-lg"
            />
            <InputGroup
                @name={{t "ember-ui.components.modals.tip-tap-editor-insert-youtube.width"}}
                @value={{@options.width}}
                @helpText={{t "ember-ui.components.modals.tip-tap-editor-insert-youtube.the-width-of-the-youtube-video"}}
                @inputClass="input-lg"
            />
        </div>
    </div>
</Modal::Default>