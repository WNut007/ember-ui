<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container">
        <InfoBlock @type="info" @icon="lightbulb" @iconSize="lg" class="mb-5">
            <div class="font-extrabold">{{t "ember-ui.components.modals.verify-by-sms.let-s-verify-your-phone-number"}}</div>
            <div>{{t "ember-ui.components.modals.verify-by-sms.confirm-your-phone-number-below-and"}}</div>
        </InfoBlock>
        <InputGroup @name={{t "ember-ui.components.modals.verify-by-sms.verify-your-phone-number"}} @helpText={{t "ember-ui.components.modals.verify-by-sms.have-a-second-look-and-confirm"}}>
            <PhoneInput @value={{@options.phone}} @onInput={{fn (mut @options.phone)}} class="form-input input-lg w-full" />
        </InputGroup>
    </div>
</Modal::Default>