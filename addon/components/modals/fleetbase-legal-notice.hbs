<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}} @modalClass="flb-resource-modal">
    <div class="modal-body-container fleetbase-legal-notice-content">
        <div class="fleetbase-legal-notice-hero">
            <div class="fleetbase-legal-notice-hero-main">
                <img
                    src="https://fleetbase.io/images/filled-icon.png"
                    alt={{t "ember-ui.components.modals.fleetbase-legal-notice.fleetbase"}}
                    width="40"
                    height="40"
                    class="fleetbase-legal-notice-logo rounded-lg shadow-md"
                />
                <div>
                    <h3>{{t "ember-ui.components.modals.fleetbase-legal-notice.fleetbase"}}</h3>
                    <p>{{t "ember-ui.components.modals.fleetbase-legal-notice.open-source-and-commercial-licensing"}}</p>
                </div>
            </div>
            <span>{{t "ember-ui.components.modals.fleetbase-legal-notice.copyright-fleetbase-pte-ltd" formatdatefns=(format-date-fns (now) "yyyy")}}</span>
        </div>

        <div class="fleetbase-legal-notice-section">
            <h4>{{t "ember-ui.components.modals.fleetbase-legal-notice.open-source-license"}}</h4>
            <p>
                {{t "ember-ui.components.modals.fleetbase-legal-notice.fleetbase-is-licensed-under-the-gnu"}}
            </p>
        </div>

        <div class="fleetbase-legal-notice-section">
            <h4>{{t "ember-ui.components.modals.fleetbase-legal-notice.no-warranty"}}</h4>
            <p>
                {{t "ember-ui.components.modals.fleetbase-legal-notice.this-program-is-distributed-without-warranty"}}
            </p>
        </div>

        <div class="fleetbase-legal-notice-section">
            <h4>{{t "ember-ui.components.modals.fleetbase-legal-notice.commercial-license"}}</h4>
            <p>
                {{t "ember-ui.components.modals.fleetbase-legal-notice.need-to-keep-proprietary-modifications-private"}}
            </p>
        </div>

        <div class="fleetbase-legal-notice-links">
            <a href="https://www.fleetbase.io/licensing" target="_blank" rel="noopener noreferrer">
                <FaIcon @icon="arrow-up-right-from-square" class="fleetbase-legal-notice-link-icon" />
                <span>{{t "ember-ui.components.modals.fleetbase-legal-notice.view-licensing-options"}}</span>
            </a>
            <a href="https://www.fleetbase.io/licensing/commercial" target="_blank" rel="noopener noreferrer">
                <FaIcon @icon="arrow-up-right-from-square" class="fleetbase-legal-notice-link-icon" />
                <span>{{t "ember-ui.components.modals.fleetbase-legal-notice.view-commercial-license"}}</span>
            </a>
            <a href="https://github.com/fleetbase/fleetbase" target="_blank" rel="noopener noreferrer">
                <FaIcon @icon="arrow-up-right-from-square" class="fleetbase-legal-notice-link-icon" />
                <span>{{t "ember-ui.components.modals.fleetbase-legal-notice.view-source-code"}}</span>
            </a>
            <a href="https://github.com/fleetbase/fleetbase/blob/main/LICENSE.md" target="_blank" rel="noopener noreferrer">
                <FaIcon @icon="arrow-up-right-from-square" class="fleetbase-legal-notice-link-icon" />
                <span>{{t "ember-ui.components.modals.fleetbase-legal-notice.view-agpl-license"}}</span>
            </a>
        </div>
    </div>
</Modal::Default>