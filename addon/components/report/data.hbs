{{#if @resource.result_columns}}
    <div class="flex items-center justify-end px-3 py-2 text-xs text-gray-500 dark:text-gray-400">
        <span class="mr-auto">
            {{t "ember-ui.components.report.data.row-count" count=this.rows.length}}
            {{#if this.limitReached}}<span class="text-amber-600 dark:text-amber-400">· {{t "ember-ui.components.report.data.limit-reached" limit=this.limit}}</span>{{/if}}
        </span>
        <Button @size="xs" @icon="file-csv" @text={{t "ember-ui.components.report.data.export-csv"}} @onClick={{this.exportCsv}} @disabled={{eq this.rows.length 0}} />
    </div>
    <div class="next-table-wrapper">
        <table>
            <thead>
                <tr>
                    {{#each @resource.result_columns as |column|}}
                        <th>{{column.label}}</th>
                    {{/each}}
                </tr>
            </thead>
            <tbody>
                {{#each @resource.data as |row|}}
                    <tr>
                        {{#each @resource.result_columns as |column|}}
                            <td>{{n-a (get row column.name)}}</td>
                        {{/each}}
                    </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
{{else}}
    <div>
        <div class="min-h-24 p-4 col-span-2">
            <div class="flex items-center justify-center border border-dashed border-gray-300 dark:border-gray-600 p-6 rounded-xl bg-gray-50 dark:bg-gray-800">
                <div class="text-center">
                    <FaIcon @icon="triangle-exclamation" @size="2x" class="text-gray-400 mb-2" />
                    <div class="text-sm text-gray-600 dark:text-gray-400 font-medium">{{t "ember-ui.components.report.data.no-report-preview"}}</div>
                    <div class="text-xs text-gray-500 dark:text-gray-500 mt-1">{{t "ember-ui.components.report.data.configure-the-report-and-press-the"}}</div>
                </div>
            </div>
        </div>
    </div>
{{/if}}